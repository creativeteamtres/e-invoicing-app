# Local development only. Copy this to .env and fill in the paths.
API_PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:8000
LEDGERLY_DB_PATH=./data/ledgerly.sqlite

# Invoice retention default is 8 years from the invoice calendar year-end.
# Set this only after a tax/legal review for the document class and customer.
LEDGERLY_RETENTION_YEARS=8

# Local-only key for encrypting per-workspace SMTP passwords; generate with npm run setup:secrets.
LEDGERLY_ENCRYPTION_KEY=

# Pinned KoSIT/XRechnung bundle is installed with npm run setup:kosit.
# Run npm run start:kosit before starting the API.
JAVA_BIN=java
KOSIT_VALIDATOR_JAR=./tools/kosit/validator-1.6.3-standalone.jar
KOSIT_SCENARIOS=./tools/kosit/xrechnung-3.0.2/scenarios.xml
KOSIT_REPOSITORY=./tools/kosit/xrechnung-3.0.2
KOSIT_RULESET_ID=XRechnung 3.0.2 (2026-08-31)
KOSIT_URL=http://127.0.0.1:8081
KOSIT_PORT=8081
KOSIT_BIND=127.0.0.1

# Mustang is used to extract embedded CII from incoming ZUGFeRD PDFs,
# package generated CII XML into PDF/A-3, and validate the final PDF.
MUSTANG_CLI_JAR=./tools/mustang/Mustang-CLI-2.26.0.jar
MUSTANG_RULESET_ID=

# Email connector (use TLS; secrets stay on the API server).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# Stripe billing remains unavailable until server-side credentials and price IDs exist.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
STRIPE_PRICE_SCALE_MONTH=
STRIPE_PRICE_SCALE_YEAR=
