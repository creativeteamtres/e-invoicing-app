# Optional API host overrides. Local defaults work without a .env file.
API_PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:8000
LEDGERLY_DB_PATH=./data/ledgerly.sqlite

# Default document retention; review per record class with German tax/legal counsel.
LEDGERLY_RETENTION_YEARS=8

# Generated locally with npm run setup:secrets. Never commit the real .env file.
LEDGERLY_ENCRYPTION_KEY=

# Pinned KoSIT/XRechnung bundle and local validator service.
JAVA_BIN=java
KOSIT_VALIDATOR_JAR=./tools/kosit/validator-1.6.3-standalone.jar
KOSIT_SCENARIOS=./tools/kosit/xrechnung-3.0.2/scenarios.xml
KOSIT_REPOSITORY=./tools/kosit/xrechnung-3.0.2
KOSIT_RULESET_ID=XRechnung 3.0.2 (2026-08-31)
KOSIT_URL=http://127.0.0.1:8081
KOSIT_PORT=8081
KOSIT_BIND=127.0.0.1

# Mustang packages and validates ZUGFeRD PDF/A-3 documents.
MUSTANG_CLI_JAR=./tools/mustang/Mustang-CLI-2.26.0.jar
MUSTANG_RULESET_ID=

# Stripe remains unavailable until these server-side credentials and plan IDs are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
STRIPE_PRICE_SCALE_MONTH=
STRIPE_PRICE_SCALE_YEAR=
